# Copie este arquivo para .env e troque a senha e a chave.

# Banco (lido pelo Docker Compose)
POSTGRES_USER=raizes
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=raizes

# API (usuário, senha e banco iguais aos de cima)
DATABASE_URL=postgresql+psycopg://raizes:troque-esta-senha@localhost:5432/raizes
JWT_SECRET=troque-por-uma-chave-com-32-caracteres-ou-mais
